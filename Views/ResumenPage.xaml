<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zenimint_Funds.Views.ResumenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenimint_Funds.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer Padding="30">
        <StackPanel Spacing="30">
            <StackPanel Orientation="Horizontal" Spacing="50">
                <StackPanel>
                    <TextBlock Text="SALDO EFECTIVO DISPONIBLE" FontSize="12" Foreground="Gray" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSaldoEfectivo" Text="$0.00" FontSize="48" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="DEUDA TOTAL EN TARJETAS" FontSize="12" Foreground="Gray" FontWeight="Bold"/>
                    <TextBlock x:Name="txtDeudaTotal" Text="$0.00" FontSize="36" FontWeight="Bold" Foreground="Red"/>
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Text="Distribución de Deuda por Tarjeta" FontSize="18" FontWeight="SemiBold"/>
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="20" Height="300">
                        <lvc:CartesianChart x:Name="chartTarjetas" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Cuentas por Cobrar" FontSize="18" FontWeight="SemiBold"/>
                    <ListView x:Name="listaDeudores" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <TextBlock Text="{Binding Nombre}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDeuda, ConverterParameter='${0:N2}'}" 
                                               HorizontalAlignment="Right" FontWeight="Bold" Foreground="OrangeRed"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
