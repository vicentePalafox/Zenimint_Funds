<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zenimint_Funds.Views.IngresosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenimint_Funds.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:Zenimint_Funds.Models"
    Loaded="Page_Loaded">


    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="30" Spacing="20" Width="350" HorizontalAlignment="Left">

            <TextBlock Text="Registrar Ingreso" FontSize="28" FontWeight="Bold"/>
            <InfoBar x:Name="Notificacion" IsOpen="False" />

            <TextBox x:Name="txtConcepto" Header="Concepto del ingreso" PlaceholderText="Ej. Quincena, Venta de sistema..."/>
            <NumberBox x:Name="numMonto" Header="Monto Recibido ($)" PlaceholderText="0.00" Minimum="0.01"/>

            <ComboBox x:Name="cmbCategoria" Header="Categoría" HorizontalAlignment="Stretch" DisplayMemberPath="Nombre"/>

            <Button x:Name="btnGuardarIngreso" Content="Guardar Ingreso" 
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                    Click="btnGuardarIngreso_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="30,30,30,0" Spacing="15">
            <TextBlock Text="Historial de Ingresos" FontSize="20" FontWeight="SemiBold" Foreground="Gray"/>

            <ListView x:Name="listaIngresos" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingreso">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Categoria.Icono}" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Concepto}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind FechaFormateada}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind MontoFormateado}" 
                                           FontSize="18" FontWeight="Bold" Foreground="MediumSeaGreen" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

    </Grid>
</Page>
